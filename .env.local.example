# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 파일명을 ".env.local" 로 바꾸고 값을 채우세요.
# .env.local 은 git에 올라가지 않습니다 (.gitignore에 등록됨).
#
# 값을 바꾼 뒤에는 개발 서버를 껐다 켜야 반영됩니다.
# ─────────────────────────────────────────────────────────────

# Meta 앱 대시보드에서 복사합니다.
# ⚠️ 앱을 만들면 App ID가 2개 나옵니다. 반드시 "Threads" 쪽 값을 쓰세요.
#    Meta 앱 ID를 넣으면 원인 없이 인증만 계속 실패합니다.
THREADS_APP_ID=

# 같은 화면의 Threads App Secret.
# ⚠️ 비밀번호와 동일하게 취급하세요. 채팅창에 붙여넣지 말고, 이 파일에만 넣으세요.
#    NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출됩니다 — 절대 붙이지 마세요.
THREADS_APP_SECRET=

# 인증이 끝나고 되돌아올 주소.
# Meta 앱 설정의 "Redirect Callback URL" 과 한 글자도 다르면 안 됩니다.
#
# 배포 후 (Vercel 주소로 교체):
#   THREADS_REDIRECT_URI=https://내프로젝트.vercel.app/api/threads/callback
#
# Threads는 https 주소를 요구하므로 localhost로는 인증이 안 됩니다.
# 그래서 Vercel 배포를 먼저 합니다.
THREADS_REDIRECT_URI=
